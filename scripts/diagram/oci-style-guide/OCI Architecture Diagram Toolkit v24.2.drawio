        <mxCell id="nU8khC_pceu9YDoVuMQo-1" parent="nU8khC_pceu9YDoVuMQo-0" />
        <mxCell id="nz10hnuV2bhbWMXzexES-0" value="&lt;div style=&quot;text-align: left&quot;&gt;&lt;b style=&quot;color: rgb(24 , 22 , 21)&quot;&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Introduction&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;p style=&quot;text-align: left ; line-height: 95% ; margin: 6pt 0in 0pt ; text-indent: 0in ; direction: ltr ; unicode-bidi: embed ; word-break: normal&quot;&gt;&lt;span style=&quot;font-size: 12px; text-indent: 0in; background-color: initial;&quot;&gt;Use this Draw.io file as a guide to create a unified visual language for topology diagrams using Oracle’s Cloud products and services. The symbols, graphics, and connecting lines will help you accurately communicate complex offerings, systems, and ideas into an Oracle-branded diagram. Please read the following quick guide to get started.&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: left ; line-height: 95% ; margin: 6pt 0in 0pt ; text-indent: 0in ; direction: ltr ; unicode-bidi: embed ; word-break: normal&quot;&gt;&lt;span style=&quot;font-size: 12px&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: left ; line-height: 95% ; margin: 6pt 0in 0pt ; text-indent: 0in ; direction: ltr ; unicode-bidi: embed ; word-break: normal&quot;&gt;&lt;span style=&quot;font-size: 12px&quot;&gt;Note: Additional direction is shown in &lt;font color=&quot;#de5b5b&quot;&gt;pink &lt;/font&gt;using the &lt;font face=&quot;Courier New&quot; color=&quot;#de5b5b&quot;&gt;Courier New Font&lt;/font&gt;. DO NOT use &lt;font color=&quot;#de5b5b&quot;&gt;pink &lt;/font&gt;or &lt;font color=&quot;#de5b5b&quot; face=&quot;Courier New&quot;&gt;Courier New&lt;/font&gt; in your diagrams.&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: left ; line-height: 95% ; margin: 6pt 0in 0pt ; text-indent: 0in ; direction: ltr ; unicode-bidi: embed ; word-break: normal&quot;&gt;&lt;span style=&quot;font-size: 12px&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: left ; line-height: 95% ; margin: 6pt 0in 0pt ; text-indent: 0in ; direction: ltr ; unicode-bidi: embed ; word-break: normal&quot;&gt;&lt;br&gt;&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;gradientColor=none;fontFamily=Oracle Sans;fontSize=11;align=center;arcSize=3;verticalAlign=top;spacingRight=5;fontColor=#312D2A;fillColor=#F5F4F2;strokeColor=#9E9892;spacingLeft=5;" parent="nU8khC_pceu9YDoVuMQo-1" vertex="1">
          <mxGeometry x="-790" y="-680" width="520" height="280" as="geometry" />
        </mxCell>
        <mxCell id="JvPnHG0KFyBG1HrR-Zid-12" value="&lt;font color=&quot;#181615&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;OCI Icon Library&lt;/font&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;p style=&quot;line-height: 95% ; margin: 6pt 0in 0pt ; text-indent: 0in ; direction: ltr ; unicode-bidi: embed ; word-break: normal&quot;&gt;&lt;span style=&quot;font-size: 12px ; text-indent: 0in&quot;&gt;The icons have moved from the OCI Library shapes to the Icons tab.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 95% ; margin: 6pt 0in 0pt ; text-indent: 0in ; direction: ltr ; unicode-bidi: embed ; word-break: normal&quot;&gt;&lt;span style=&quot;font-size: 12px ; text-indent: 0in&quot;&gt;Copy and paste the desired icon on&lt;/span&gt;&lt;span style=&quot;font-size: 12px; text-indent: 0in; background-color: initial;&quot;&gt;&amp;nbsp;your artboard to create OCI diagrams to&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 12px; text-indent: 0in; background-color: initial;&quot;&gt;Oracle standards.&lt;/span&gt;&lt;/p&gt;&lt;b style=&quot;font-size: 12px&quot;&gt;&lt;br&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;gradientColor=none;fontFamily=Oracle Sans;fontSize=11;align=left;arcSize=3;verticalAlign=top;spacingRight=5;fontColor=#312D2A;fillColor=#F5F4F2;strokeColor=#9E9892;spacingLeft=5;" parent="nU8khC_pceu9YDoVuMQo-1" vertex="1">
