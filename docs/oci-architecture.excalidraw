    {
      "type": "text",
      "id": "tb_pub_sl_t",
      "x": 1185,
      "y": 1144,
      "width": 366,
      "height": 372,
      "text": "PUBLIC subnet SL\n\nINGRESS\n  TCP 443   ← nlb_allowed_cidrs\n            (0.0.0.0/0)\n  TCP 6443  ← nlb_allowed_cidrs\n            (k8s API)\n  ALL       ← 10.2.0.0/16 (VCN)\n  ALL       ← 10.1.0.0/16 (peer)\n\nEGRESS\n  ALL       → 0.0.0.0/0\n  TCP 30443 → 10.2.1.0/24 (priv)\n  TCP 10256 → 10.2.1.0/24 (priv)",
      "originalText": "PUBLIC subnet SL\n\nINGRESS\n  TCP 443   ← nlb_allowed_cidrs\n            (0.0.0.0/0)\n  TCP 6443  ← nlb_allowed_cidrs\n            (k8s API)\n  ALL       ← 10.2.0.0/16 (VCN)\n  ALL       ← 10.1.0.0/16 (peer)\n\nEGRESS\n  ALL       → 0.0.0.0/0\n  TCP 30443 → 10.2.1.0/24 (priv)\n  TCP 10256 → 10.2.1.0/24 (priv)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
