    {
      "type": "text",
      "id": "tb_work_pool_t",
      "x": 1765,
      "y": 846,
      "width": 190,
      "height": 226,
      "text": "Node Pool: WORKLOAD\nnp-...-workload\ncount = 2\n2 OCPU / 12 GB each\n\nNode 1 + Node 2\n  label name=oke-...\n  label tier=workload\n  (no taint)\n\nNLB backends :30443\n(one per node)",
      "originalText": "Node Pool: WORKLOAD\nnp-...-workload\ncount = 2\n2 OCPU / 12 GB each\n\nNode 1 + Node 2\n  label name=oke-...\n  label tier=workload\n  (no taint)\n\nNLB backends :30443\n(one per node)",
